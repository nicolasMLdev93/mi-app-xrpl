# ========================
#  Dependencias (SIEMPRE)
# ========================
node_modules/
**/node_modules/

# ========================
#  Código compilado (TypeScript, etc.)
# ========================
dist/
*.tsbuildinfo

# ========================
#  Variables de entorno (¡NUNCA subir!)
# ========================
.env
.env.local
.env.*.local

# ========================
#  Configuración de base de datos (con credenciales)
#  - config.json (si lo usas) debe ignorarse porque contiene credenciales
#  - config.js (que usa variables de entorno) NO debe ignorarse, debe subirse
# ========================
# Ignora cualquier archivo config.json dentro de carpetas config
**/config/config.json
**/config/*.json

# ========================
#  Logs
# ========================
logs/
*.log
npm-debug.log*
sequelize.log

# ========================
#  Archivos de sistema operativo
# ========================
.DS_Store
Thumbs.db
desktop.ini

# ========================
#  Editores / IDEs
# ========================
.vscode/
.idea/
*.swp
*.swo
*~

# ========================
#  Testing y cobertura
# ========================
coverage/
.nyc_output/

# ========================
#  Temporales y cachés
# ========================
tmp/
temp/
*.tmp
.eslintcache
.prettiercache

# ========================
#  Bases de datos locales (SQLite)
# ========================
*.sqlite
*.db
*.sqlite3

# ========================
#  Bloqueadores de versiones (opcional)
# ========================
package-lock.json
yarn.lock